{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/developers",
      "destination": "/developers.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}